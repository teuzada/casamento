/** Google Apps Script vinculado à planilha de confirmações.
 * Em Propriedades do script, crie RSVP_SECRET com o mesmo valor configurado no Vercel.
 * Implante como aplicativo da Web: executar como você; acesso: qualquer pessoa.
 * A URL /exec vai na variável RSVP_SHEETS_WEBHOOK_URL do Vercel.
 */
function doPost(e){try{const data=JSON.parse(e.postData.contents);const secret=PropertiesService.getScriptProperties().getProperty("RSVP_SECRET");if(!secret||data.secret!==secret)throw Error("Não autorizado");const name=String(data.name||"").trim();const guests=data.companions;if(name.length<2||name.length>120||!Array.isArray(guests)||guests.length>15||guests.some(x=>typeof x!=="string"||x.trim().length<2||x.trim().length>120))throw Error("Dados inválidos");const book=SpreadsheetApp.getActiveSpreadsheet();const sheet=book.getSheetByName("Confirmações")||book.insertSheet("Confirmações");if(sheet.getLastRow()===0)sheet.appendRow(["Data/hora","Convidado principal","Acompanhantes","Total de pessoas"]);const clean=s=>{const v=String(s).trim();return /^[=+@\-]/.test(v)?"'"+v:v};const lock=LockService.getScriptLock();lock.waitLock(10000);try{sheet.appendRow([new Date(),clean(name),guests.map(clean).join(" | "),1+guests.length])}finally{lock.releaseLock()}return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(error){return ContentService.createTextOutput(JSON.stringify({ok:false,error:"Registro não autorizado ou inválido"})).setMimeType(ContentService.MimeType.JSON)}}
